+// Place a zero-length caret at the end of `range` using a fresh cloned range.
+// Mutating the current selection range with ShiftEndToRange() leaves the start
+// anchor untouched in some XAML/UWP hosts (Windows Search, Task Manager), which
+// shows the just-committed text as a blue selection. A cloned, collapsed range
+// is unambiguous and gives exactly one caret position.
+bool setCaretAtRangeEnd(ITfContext* context, TfEditCookie editCookie, ITfRange* range,
+                        const wchar_t* tag) {
+    if (!context || !range) {
+        return false;
+    }
+    ComPtr<ITfRange> caretRange;
+    if (range->Clone(&caretRange) != S_OK || !caretRange) {
+        logTextServiceDebug(std::wstring(L"[") + tag + L"] clone range failed");
+        return false;
+    }
+    if (caretRange->Collapse(editCookie, TF_ANCHOR_END) != S_OK) {
+        logTextServiceDebug(std::wstring(L"[") + tag + L"] collapse failed");
+        return false;
+    }
+
+    TF_SELECTION selection = {};
+    selection.range = caretRange;
+    selection.style.ase = TF_AE_NONE;
+    selection.style.fInterimChar = FALSE;
+    const HRESULT hr = context->SetSelection(editCookie, 1, &selection);
+    if (FAILED(hr)) {
+        logTextServiceDebug(std::wstring(L"[") + tag + L"] SetSelection failed hr=" +
+                            std::to_wstring(static_cast<long>(hr)));
+        return false;
+    }
+    auto rangeAcp = caretRange.query<ITfRangeACP>();
+    if (rangeAcp) {
+        LONG anchor = 0;
+        LONG length = -1;
+        if (rangeAcp->GetExtent(&anchor, &length) == S_OK) {
+            logTextServiceDebug(std::wstring(L"[") + tag + L"] caret anchor=" +
+                                std::to_wstring(anchor) + L" len=" +
+                                std::to_wstring(length));
+        }
+    }
+    return true;
+}
